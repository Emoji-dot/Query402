STELLAR_NETWORK=stellar:testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_FACILITATOR_API_KEY=
X402_PAY_TO_ADDRESS=INVALID_DEMO_PAY_TO_ADDRESS
DEMO_CLIENT_SECRET_KEY=INVALID_DEMO_SECRET_KEY
DEMO_CLIENT_PUBLIC_KEY=INVALID_DEMO_PUBLIC_KEY
PORT_API=3001
# Maximum JSON request body size in bytes. Default is 65536 (64 KiB).
# A body of this size is accepted; one byte over returns HTTP 413
# with errorCode json_body_too_large. The rejected body is not logged.
API_JSON_BODY_MAX_BYTES=65536
PORT_WEB=5173
API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001
DEMO_MODE=true

# Sponsorship (issue #9) — default off (fail closed)
SPONSORSHIP_ENABLED=false
SPONSORSHIP_SIGNING_SECRET=
SPONSORSHIP_GLOBAL_DAILY_BUDGET_USD=10
SPONSORSHIP_PER_WALLET_DAILY_BUDGET_USD=1
SPONSORSHIP_RATE_LIMIT_PER_MINUTE=10
SPONSORSHIP_GRANT_TTL_SECONDS=300
SPONSORSHIP_CHALLENGE_TTL_SECONDS=60
SPONSORSHIP_DB_PATH=data/sponsorship.db
IDEMPOTENCY_TTL_SECONDS=86400

# Analytics storage (issue #5)
ANALYTICS_STORAGE=sqlite
ANALYTICS_DB_PATH=data/analytics.db

# Optional provider keys
BRAVE_API_KEY=
SERPAPI_API_KEY=
NEWS_API_KEY=
